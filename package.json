    "voice": "node tools/genvoice.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.48.0",
    "typescript": "^5.6.0"
  }
}
