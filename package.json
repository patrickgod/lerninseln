{
  "name": "lerninseln",
  "version": "0.1.0",
  "private": true,
  "description": "LernInseln - eine Lernapp fuer die erste Klasse. Inseln, Haeuser, Aufgaben.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node tools/build.mjs",
